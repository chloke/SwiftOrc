{
  "indentation": {
    "spaces": 4
  },
  "lineLength": 100,
  "multiElementCollectionTrailingCommas": true,
  "respectsExistingLineBreaks": true,
  "rules": {
    "NeverForceUnwrap": false,
    "NeverUseForceTry": true,
    "OrderedImports": true,
    "UseLetInEveryBoundCaseVariable": false
  },
  "version": 1
}
